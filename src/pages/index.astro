---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog MedSmell: olfato, perda de olfato e treinamento olfativo" description="Artigos da MedSmell sobre olfato: anosmia, hiposmia, parosmia, teste de olfato e treinamento olfativo, com fontes e revisão.">
  <h1>Blog MedSmell</h1>
  <p class="meta">Informação sobre olfato, com fontes citadas e revisão. Conteúdo informativo, não substitui a consulta médica.</p>
  {posts.length === 0 ? (
    <p>Os primeiros artigos estão chegando. Enquanto isso, conheça os <a href="https://www.medsmell.com.br/treinamento-olfativo?utm_source=blog">kits de treinamento olfativo</a>.</p>
  ) : (
    <ul class="lista">
      {posts.map((p) => (
        <li>
          <h2><a href={`/${p.id}/`}>{p.data.title}</a></h2>
          <div class="meta">{fmt(p.data.pubDate)}</div>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
